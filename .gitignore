# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.whl

# Environment & secrets (never commit .env)
.env
.env.local
.env.*.local

# Runtime databases & temporary caches
data/*.db
data/*.db-wal
data/*.db-shm
data/local_models/*
!data/local_models/.gitkeep
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Frontend dependencies
frontend/node_modules/
node_modules/
exports/aud_*_report.*
