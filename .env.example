# ModelTrace V1 — Example Environment Configuration (.env.example)
# Copy to .env for local customization. NEVER commit real API keys or .env to version control.

# 1. Localhost Server Binding (Single-User Workbench)
MODELTRACE_HOST=127.0.0.1
MODELTRACE_PORT=8000
MODELTRACE_DB_PATH=./data/modeltrace.db
MODELTRACE_EXPORTS_DIR=./exports
MODELTRACE_LOCAL_MODELS_DIR=./data/local_models
MODELTRACE_MAX_RESPONSE_BYTES=2097152
MODELTRACE_MAX_UPLOAD_BYTES=2097152

# 2. Allowed Frontend & Outbound Origins (Comma-Separated scheme://host:port)
MODELTRACE_ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
MODELTRACE_DEFAULT_ALLOWED_OUTBOUND_ORIGINS=https://api.openai.com:443,https://api.together.xyz:443,https://api.fireworks.ai:443,https://openrouter.ai:443
MODELTRACE_DEFAULT_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:11434,http://localhost:11434

# 3. Provider API Key Environment Variables (Referenced by name in Endpoint Profiles)
# Must match ^MODELTRACE_PROVIDER_[A-Z0-9_]+$
MODELTRACE_PROVIDER_REFERENCE_KEY=replace_with_your_reference_api_key
MODELTRACE_PROVIDER_TARGET_KEY=replace_with_your_target_api_key
MODELTRACE_PROVIDER_TOGETHER_KEY=replace_with_your_together_api_key
MODELTRACE_PROVIDER_FIREWORKS_KEY=replace_with_your_fireworks_api_key
